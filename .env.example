# ─────────────────────────────────────────────────────────────────────────────
# Sinaptik2 — configuração do servidor
# Copia este ficheiro para .env e ajusta os valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Segurança ─────────────────────────────────────────────────────────────────
# Muda OBRIGATORIAMENTE em produção!
SECRET_KEY=muda-esta-chave-para-algo-secreto-e-longo-pelo-menos-32-caracteres
ADMIN_PASSWORD=admin123

# Duração da sessão em minutos (padrão: 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Porta da aplicação ────────────────────────────────────────────────────────
APP_PORT=61100

# ── IA — opcional (só necessário para o assistente de chat) ───────────────────
ANTHROPIC_API_KEY=
# Chave Gemini gratuita em https://aistudio.google.com
GEMINI_API_KEY=

# ── Orçamento de memória (total recomendado: ≤ 2 GB) ─────────────────────────
#
#   BACKEND_MEM_LIMIT   inclui FastAPI + gerador de horários (solver)
#   FRONTEND_MEM_LIMIT  nginx a servir ficheiros estáticos (usa muito pouco)
#   SOLVER_MAX_MEMORY_MB deve ser < BACKEND_MEM_LIMIT (em MB)
#
#   Valores padrão:  backend 1700m + frontend 256m = ~1956m ≈ 1.9 GB
#
# NAS com ≤ 4 GB RAM — valores conservadores:
BACKEND_MEM_LIMIT=1700m
FRONTEND_MEM_LIMIT=256m
SOLVER_MAX_MEMORY_MB=900

# NAS com ≥ 8 GB RAM — podes aumentar:
# BACKEND_MEM_LIMIT=3072m
# FRONTEND_MEM_LIMIT=512m
# SOLVER_MAX_MEMORY_MB=2048

# Servidor dedicado com ≥ 16 GB RAM:
# BACKEND_MEM_LIMIT=6144m
# FRONTEND_MEM_LIMIT=512m
# SOLVER_MAX_MEMORY_MB=4096

# ── Solver (gerador de horários) ──────────────────────────────────────────────
# Número de workers paralelos (0 = automático = nº de CPUs)
# Num NAS recomenda-se 1 ou 2 para não sobrecarregar o sistema.
SOLVER_WORKERS=2

